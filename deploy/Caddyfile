# Kalks production edge (Caddy). HTTPS certificates are issued and renewed automatically.
{
	email admin@kalkstrade.com
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Client Area (CRM). /support/stream = support chat + notifications stream (one-time ticket from the CRM BFF).
app.kalkstrade.com {
	import common
	handle /support/stream {
		rewrite * /v1/stream?{query}
		reverse_proxy 127.0.0.1:8100
	}
	# support chat attachments: 10 MB files; the support service enforces the exact limit and sniffs the type
	@supportUpload path /api/support/attachments
	request_body @supportUpload {
		max_size 11MB
	}
	# KYC uploads: 10 MB files (+ multipart overhead); the gateway enforces the exact limit and sniffs the type
	@kycUpload path /api/kyc/documents
	request_body @kycUpload {
		max_size 12MB
	}
	reverse_proxy 127.0.0.1:3000
}

# Kalks Trader. /engine/stream = trading-engine account stream (one-time ticket from the terminal BFF);
# /options/stream = options chain stream (one-time ticket from the terminal BFF, or the guest public chain).
trade.kalkstrade.com {
	import common
	handle /engine/stream {
		rewrite * /v1/terminal/stream?{query}
		reverse_proxy 127.0.0.1:8090
	}
	handle /options/stream {
		rewrite * /v1/options/stream?{query}
		reverse_proxy 127.0.0.1:8104
	}
	handle {
		reverse_proxy 127.0.0.1:3002
	}
}

# Back Office. /engine/stream = trading-engine dealing stream (one-time ticket from the admin BFF);
# /support/stream = support inbox + staff notifications stream (one-time ticket from the admin BFF).
admin.kalkstrade.com {
	import common
	handle /support/stream {
		rewrite * /v1/stream?{query}
		reverse_proxy 127.0.0.1:8100
	}
	handle /engine/stream {
		rewrite * /v1/dealing/stream?{query}
		reverse_proxy 127.0.0.1:8090
	}
	handle {
		reverse_proxy 127.0.0.1:3001
	}
}

# Public market data (quotes, candles, WebSocket stream). Admin endpoints are never exposed.
api.kalkstrade.com {
	import common
	# ALGO public surface only: webhook alerts and the API-key REST API (everything else needs the internal token)
	handle_path /algo/* {
		@algoPublic path /hooks/* /public/v1/*
		handle @algoPublic {
			request_body {
				max_size 64KB
			}
			reverse_proxy 127.0.0.1:8099
		}
		respond 404
	}
	# Kalks FX Options public chain (read-only; the service answers 404 until the public chain is switched on)
	handle /v1/public/options/* {
		reverse_proxy 127.0.0.1:8104
	}
	# admin (spreads) and internal (service-to-service) endpoints stay on the server
	@admin path /v1/admin* /v1/internal*
	respond @admin 404
	reverse_proxy 127.0.0.1:8081
}

# Website (deployed separately from the website repo on :3010)
kalkstrade.com {
	import common
	# The Android app (APK) and other downloads: static files uploaded to the server, outside git
	handle_path /download/* {
		root * /srv/kalks/downloads
		header Content-Type application/vnd.android.package-archive
		header Content-Disposition "attachment"
		file_server
	}
	reverse_proxy 127.0.0.1:3010
}

www.kalkstrade.com {
	redir https://kalkstrade.com{uri} permanent
}

# ---- Demo showcase (mock data, no sign-in). Not indexed by search engines. ----
(demo) {
	import common
	header X-Robots-Tag "noindex, nofollow"
}

demo.kalkstrade.com {
	import demo
	reverse_proxy 127.0.0.1:4000
}

demo-admin.kalkstrade.com {
	import demo
	reverse_proxy 127.0.0.1:4001
}

demo-trade.kalkstrade.com {
	import demo
	reverse_proxy 127.0.0.1:4002
}

# ---- White-label broker domains (on-demand TLS) — NOT ENABLED ----
# Brokers' own hosts (tenant_domains, managed in Owner → Brokers → Domains) get certificates on their first
# visit. Caddy asks the gateway before issuing: /v1/public/domain-check answers 200 only for an active domain
# of an active broker, and only to loopback callers, so random hostnames pointed at the server get nothing.
# The explicit kalkstrade.com blocks above keep precedence (Caddy prefers the most specific host match).
# To enable: move the `on_demand_tls` option into the global block at the top, uncomment the site block,
# `caddy validate`, reload. Routing is by the first label (the Owner panel suggests the same kinds):
# app./my./client./portal. → Client Area, trade./trader./webtrader. → Trader, admin./backoffice./bo. → Back
# Office; anything else (the broker's apex / www) redirects to its Client Area. The gateway maps each host to
# its broker (X-Kalks-Host from the app BFFs), so one app process serves every broker.
#
# {
# 	on_demand_tls {
# 		ask http://127.0.0.1:8080/v1/public/domain-check
# 	}
# }
#
# https:// {
# 	import common
# 	tls {
# 		on_demand
# 	}
# 	@app header_regexp Host ^(app|my|client|portal)\.
# 	@trade header_regexp Host ^(trade|trader|webtrader)\.
# 	@admin header_regexp Host ^(admin|backoffice|bo)\.
# 	handle @app {
# 		handle /support/stream {
# 			rewrite * /v1/stream?{query}
# 			reverse_proxy 127.0.0.1:8100
# 		}
# 		@kycUpload path /api/kyc/documents
# 		request_body @kycUpload {
# 			max_size 12MB
# 		}
# 		reverse_proxy 127.0.0.1:3000
# 	}
# 	handle @trade {
# 		handle /engine/stream {
