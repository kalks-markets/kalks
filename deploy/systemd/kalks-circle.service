[Unit]
Description=Kalks Circle: the trader community (posts, stories, chat, rooms, video) (:8105)
After=network-online.target postgresql.service kalks-gateway.service kalks-support.service
Wants=network-online.target

[Service]
User=kalks
WorkingDirectory=/home/kalks/kalks/services/circle
EnvironmentFile=/home/kalks/kalks/.env.local
EnvironmentFile=-/home/kalks/kalks/.env.claude
Environment=RUST_LOG=info
Environment=CIRCLE_ENV=production
Environment=CIRCLE_BIND=127.0.0.1:8105
ExecStart=/home/kalks/kalks/target/release/circle
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
