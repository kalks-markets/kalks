[Unit]
Description=Kalks Client Area (:3000)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=kalks
WorkingDirectory=/home/kalks/kalks/apps/crm
Environment=NODE_ENV=production
# -H localhost, not 127.0.0.1: Next names the middleware request URL "localhost" for any loopback host, and a
# rewrite whose host differs from the one the server started with is proxied out over HTTPS (Caddy sends
# X-Forwarded-Proto) and fails; IPv4 first so "localhost" binds 127.0.0.1, where Caddy connects.
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStart=/home/kalks/kalks/apps/crm/node_modules/.bin/next start -p 3000 -H localhost
Restart=always
RestartSec=3
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
