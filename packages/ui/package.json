{
  "name": "@kalks/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./tokens": "./src/tokens.ts",
    "./fonts": "./src/fonts.ts",
    "./theme": "./src/shell/theme.tsx",
    "./brand": "./src/shell/brand.tsx",
    "./brand-vars": "./src/shell/brand-vars.ts",
    "./providers": "./src/shell/providers.tsx",
    "./logo": "./src/shell/logo.tsx",
    "./primitives": "./src/components/primitives.tsx",
    "./swr-cache": "./src/lib/swr-cache.ts",
    "./illustration": "./src/components/illustration.tsx",
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/gen-tokens.mjs"
  },
  "dependencies": {
    "@kalks/i18n": "workspace:*",
    "@kalks/mock": "workspace:*",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "d3-geo": "3.1.1",
    "flag-icons": "7.5.0",
    "lightweight-charts": "5.2.1",
    "lucide-react": "1.48.0",
    "motion": "13.4.2",
    "next-themes": "0.4.6",
    "qrcode.react": "4.2.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "peerDependencies": {
    "next": "^16",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "7946.0.16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "typescript": "5.9.3"
  }
}
