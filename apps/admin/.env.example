# Back Office (apps/admin). Copy to .env.local. All values are server-only unless prefixed NEXT_PUBLIC_.

# Rust gateway (staff sign-in, sessions, audit log, admin read APIs)
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_TOKEN=<same value as GATEWAY_INTERNAL_TOKEN in the gateway env>

# Market-data service admin API (spread markups). Never exposed to the browser.
MARKET_DATA_URL=http://127.0.0.1:8081
MARKET_DATA_ADMIN_TOKEN=<same value as MARKET_DATA_ADMIN_TOKEN in the market-data env>

# Build mode: "live" (default, real data only) or "demo" (full mock showcase, no staff sign-in)
# NEXT_PUBLIC_KALKS_MODE=live

# Trading engine (services/trading): dealing desk, trading accounts, groups. Never exposed to the browser.
TRADING_URL=http://127.0.0.1:8090
TRADING_INTERNAL_TOKEN=<same value as TRADING_INTERNAL_TOKEN in the root .env.local>
# Browser URL of the dealing WebSocket. Leave unset in production: the page uses wss://<admin host>/engine/stream
# (Caddy forwards it to the engine). Locally: ws://127.0.0.1:8090/v1/dealing/stream
# TRADING_STREAM_URL=ws://127.0.0.1:8090/v1/dealing/stream

# IB / referral programme (services/ib, :8096) for the /api/partners BFF. Server-only; same value as IB_INTERNAL_TOKEN in the root .env.local
IB_URL=http://127.0.0.1:8096
IB_INTERNAL_TOKEN=<openssl rand -hex 32>

# Prop firm service (services/prop, :8097) for the /api/prop BFF. Server-only; same value as PROP_INTERNAL_TOKEN in the root .env.local
PROP_URL=http://127.0.0.1:8097
PROP_INTERNAL_TOKEN=<openssl rand -hex 32>

# Academy (services/academy, :8098) for the /api/academy BFF. Server-only; same value as ACADEMY_INTERNAL_TOKEN in the root .env.local
ACADEMY_URL=http://127.0.0.1:8098
ACADEMY_INTERNAL_TOKEN=<openssl rand -hex 32>

# Wallet service (services/wallet): Finance -> deposits, withdrawals, wallets, reconciliation, wallet settings. Server-only.
WALLET_URL=http://127.0.0.1:8095
WALLET_INTERNAL_TOKEN=<same value as WALLET_INTERNAL_TOKEN in the root .env.local>

# ALGO service (services/algo, :8099) for the /api/algo BFF: strategies, backtests, runtime, webhooks, API keys, marketplace. Server-only; same value as ALGO_INTERNAL_TOKEN in the root .env.local
ALGO_URL=http://127.0.0.1:8099
ALGO_INTERNAL_TOKEN=<openssl rand -hex 32>

# Growth service (services/growth, :8101): Marketing -> bonuses, promo codes, banners, contests, rewards, cashback, reports.
# Server-only; same value as GROWTH_INTERNAL_TOKEN in the root .env.local
GROWTH_URL=http://127.0.0.1:8101
GROWTH_INTERNAL_TOKEN=<openssl rand -hex 32>

# Support chat + notifications service (services/support). Same token as SUPPORT_INTERNAL_TOKEN in the root .env.local.
# SUPPORT_STREAM_URL overrides the browser stream URL (default: the service in development, wss://<host>/support/stream in production).
SUPPORT_URL=http://127.0.0.1:8100
SUPPORT_INTERNAL_TOKEN=

# Reports service (services/reports, :8102): statements, analytics and reports for the /api/reports BFF.
# Server-only; same value as REPORTS_INTERNAL_TOKEN in the root .env.local
REPORTS_URL=http://127.0.0.1:8102
REPORTS_INTERNAL_TOKEN=<openssl rand -hex 32>

# Kalks FX Options service (services/options, :8104) for the /api/options BFF: underlyings, series, vol surfaces, rates,
# holidays, spreads / fees / limits, dealer controls, fixings, broker switches, audit. Server-only; same value as
# OPTIONS_INTERNAL_TOKEN in the root .env.local (required when the service runs with OPTIONS_ENV=production).
# The option book, settlement re-runs and voids go through the trading engine (TRADING_URL above).
OPTIONS_URL=http://127.0.0.1:8104
OPTIONS_INTERNAL_TOKEN=<openssl rand -hex 32>

# Site content + media library (services/content, :8105) for the /api/content BFF (Content → Pages, Media library).
# Server-only; same value as CONTENT_INTERNAL_TOKEN in the root .env.local
CONTENT_URL=http://127.0.0.1:8105
CONTENT_INTERNAL_TOKEN=<openssl rand -hex 32>
# Where the "Preview" button opens each surface (<base>/api/content-preview?token=…&path=…); also the base of built-in
# default images shown in the editor
CONTENT_PREVIEW_WEBSITE_URL=http://localhost:3010
CONTENT_PREVIEW_APP_URL=http://localhost:3000
CONTENT_PREVIEW_TRADER_URL=http://localhost:3002
