# Client Area (apps/crm). Copy to .env.local (development) or .env.production.local (server).
# All values are server-only unless prefixed NEXT_PUBLIC_.

# Rust gateway (client sign-in, sessions, audit log)
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_TOKEN=<same value as GATEWAY_INTERNAL_TOKEN in the gateway env>

# Google sign-in ("Continue with Google"). OAuth 2.0 client of type "Web application" in Google Cloud.
# Authorised redirect URIs on that client: https://app.kalkstrade.com/api/auth/google/callback
# (and http://localhost:3000/api/auth/google/callback for local testing).
GOOGLE_CLIENT_ID=<...apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<GOCSPX-...>
# Shows the Google button on /login and /register. Inlined at build time: set it before `next build`.
NEXT_PUBLIC_GOOGLE_LOGIN=1

# IB / referral programme (services/ib, :8096) for the /api/partner BFF. Server-only; same value as IB_INTERNAL_TOKEN in the root .env.local
IB_URL=http://127.0.0.1:8096
IB_INTERNAL_TOKEN=<openssl rand -hex 32>

# Prop challenges (services/prop, :8097) for the /api/prop BFF and the public /verify/<code> page. Server-only; same value as PROP_INTERNAL_TOKEN in the root .env.local
PROP_URL=http://127.0.0.1:8097
PROP_INTERNAL_TOKEN=<openssl rand -hex 32>

# Academy (services/academy, :8098) for the /api/academy BFF. Server-only; same value as ACADEMY_INTERNAL_TOKEN in the root .env.local
ACADEMY_URL=http://127.0.0.1:8098
ACADEMY_INTERNAL_TOKEN=<openssl rand -hex 32>

# Wallet service (services/wallet) for the /api/wallet BFF: deposits, withdrawals, transfers. Server-only.
WALLET_URL=http://127.0.0.1:8095
WALLET_INTERNAL_TOKEN=<same value as WALLET_INTERNAL_TOKEN in the root .env.local>

# Growth service (services/growth, :8101) for the /api/growth BFF: rewards, cashback, contests, bonuses, banners, share cards. Server-only; same value as GROWTH_INTERNAL_TOKEN in the root .env.local
GROWTH_URL=http://127.0.0.1:8101
GROWTH_INTERNAL_TOKEN=<same value as GROWTH_INTERNAL_TOKEN in the root .env.local>

# ALGO service (services/algo, :8099) for the /api/algo BFF: strategies, backtests, runtime, webhooks, API keys, marketplace. Server-only; same value as ALGO_INTERNAL_TOKEN in the root .env.local
ALGO_URL=http://127.0.0.1:8099
ALGO_INTERNAL_TOKEN=<openssl rand -hex 32>

# Support chat + notifications service (services/support). Same token as SUPPORT_INTERNAL_TOKEN in the root .env.local.
# SUPPORT_STREAM_URL overrides the browser stream URL (default: the service in development, wss://<host>/support/stream in production).
SUPPORT_URL=http://127.0.0.1:8100
SUPPORT_INTERNAL_TOKEN=

# Reports service (services/reports, :8102): statements, analytics and reports for the /api/reports BFF.
# Server-only; same value as REPORTS_INTERNAL_TOKEN in the root .env.local
REPORTS_URL=http://127.0.0.1:8102
REPORTS_INTERNAL_TOKEN=<openssl rand -hex 32>

# Mobile app API (/api/mobile/*, docs/MOBILE-API.md). All optional.
# Kalks FX Options service for the app's options reads (the deploy script sets these for the Client Area).
OPTIONS_URL=http://127.0.0.1:8104
OPTIONS_INTERNAL_TOKEN=<same value as OPTIONS_INTERNAL_TOKEN in the root .env.local>
# AI Trader and "Explain it to me" in the app (same key as Kalks Trader's). Unset = the app's built-in fallbacks.
ANTHROPIC_API_KEY=
# Oldest app version allowed to run (the app asks to update below it), e.g. 1.0.0. Unset = any.
MOBILE_MIN_APP_VERSION=
# Where an outdated app sends the user to update (config.updateUrl). Unset = <this host>/download (the APK page).
# MOBILE_UPDATE_URL=https://app.kalkstrade.com/download
# Key that binds the app's trade tokens to the client. Unset = derived from the internal tokens.
MOBILE_TRADE_SECRET=
# Pin a public URL handed to the app (default: derived from NEXT_PUBLIC_MARKET_DATA_URL / NEXT_PUBLIC_TERMINAL_URL / this host).
# MOBILE_MARKET_DATA_URL=https://api.kalkstrade.com
# MOBILE_ENGINE_STREAM_URL=wss://trade.kalkstrade.com/engine/stream
# MOBILE_OPTIONS_STREAM_URL=wss://trade.kalkstrade.com/options/stream
# MOBILE_SUPPORT_STREAM_URL=wss://app.kalkstrade.com/support/stream

# Android app page (/download): the release manifest written by deploy/publish-app.sh. Unset = <this host>/downloads/latest.json
# (Caddy serves /srv/kalks/downloads there). The APK link is resolved next to it. Missing / invalid = "Download coming soon".
# APP_DOWNLOAD_MANIFEST_URL=https://app.kalkstrade.com/downloads/latest.json
